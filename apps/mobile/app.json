{
  "expo": {
    "name": "MedGuides",
    "slug": "medguides",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#245C49",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "../../packages/ui-tokens/fonts/Inter_400Regular.ttf",
              "../../packages/ui-tokens/fonts/Inter_500Medium.ttf",
              "../../packages/ui-tokens/fonts/Inter_600SemiBold.ttf",
              "../../packages/ui-tokens/fonts/Inter_700Bold.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Inter",
                "fontDefinitions": [
                  {
                    "path": "../../packages/ui-tokens/fonts/Inter_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "../../packages/ui-tokens/fonts/Inter_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "../../packages/ui-tokens/fonts/Inter_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "../../packages/ui-tokens/fonts/Inter_700Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ]
    ],
    "scheme": "medguides"
  }
}
