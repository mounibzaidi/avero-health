{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "fiche"
    },
    "meta": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "topic_id": {
          "type": "string",
          "minLength": 1
        },
        "template": {
          "type": "string",
          "enum": [
            "urgence",
            "pathologie"
          ]
        },
        "audience": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "MG",
              "urgences"
            ]
          }
        },
        "version": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "published"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "siblings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceMeta"
          }
        },
        "excluded_by_audience": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quote_check": {
          "type": "string"
        },
        "motifs": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "synonymes": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "specialite": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "title",
        "topic_id",
        "template",
        "audience",
        "version",
        "status",
        "reviewer",
        "reviewed_at",
        "siblings",
        "sources",
        "excluded_by_audience",
        "specialite"
      ],
      "additionalProperties": false
    },
    "sections": {
      "type": "object",
      "properties": {
        "1_essentiel": {
          "$ref": "#/$defs/Block"
        },
        "2_presentation": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "filled",
                "non_traité",
                "sans_objet"
              ]
            },
            "signes_typiques": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Element"
              }
            },
            "formes_trompeuses": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Element"
              }
            },
            "examen_clinique": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Element"
              }
            },
            "criteres_diagnostiques": {
              "default": [],
              "type": "array",
              "items": {
                "$ref": "#/$defs/Element"
              }
            },
            "diagnostics_differentiels": {
              "default": [],
              "type": "array",
              "items": {
                "$ref": "#/$defs/Element"
              }
            }
          },
          "required": [
            "state",
            "signes_typiques",
            "formes_trompeuses",
            "examen_clinique"
          ],
          "additionalProperties": false
        },
        "3_champ": {
          "$ref": "#/$defs/Block"
        },
        "4_gravite": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "filled",
                "non_traité",
                "sans_objet"
              ]
            },
            "decision_initiale": {
              "$ref": "#/$defs/Block"
            },
            "signes_de_gravite": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Element"
              }
            },
            "gestes_immediats": {
              "$ref": "#/$defs/Block"
            }
          },
          "required": [
            "state",
            "signes_de_gravite",
            "gestes_immediats"
          ],
          "additionalProperties": false
        },
        "5_conduite": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "filled",
                "non_traité",
                "sans_objet"
              ]
            },
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "node": {
                    "type": "string",
                    "minLength": 1
                  },
                  "branches": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/Element"
                    }
                  }
                },
                "required": [
                  "node",
                  "branches"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "state",
            "nodes"
          ],
          "additionalProperties": false
        },
        "6_examens": {
          "$ref": "#/$defs/Block"
        },
        "7_traitement": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "filled",
                "non_traité",
                "sans_objet"
              ]
            },
            "elements": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Element"
              }
            },
            "contre_indications": {
              "$ref": "#/$defs/Block"
            },
            "posologies": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Posologie"
              }
            }
          },
          "required": [
            "state",
            "elements",
            "contre_indications",
            "posologies"
          ],
          "additionalProperties": false
        },
        "8_ne_pas_faire": {
          "$ref": "#/$defs/Block"
        },
        "9_orientation": {
          "$ref": "#/$defs/Block"
        },
        "10_surveillance": {
          "$ref": "#/$defs/Block"
        },
        "11_suivi": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "filled",
                "non_traité",
                "sans_objet"
              ]
            },
            "elements": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Element"
              }
            },
            "conseils_patient": {
              "default": [],
              "type": "array",
              "items": {
                "$ref": "#/$defs/Element"
              }
            }
          },
          "required": [
            "state",
            "elements"
          ],
          "additionalProperties": false
        },
        "12_ordonnance": {
          "$ref": "#/$defs/Block"
        },
        "13_definitions": {
          "$ref": "#/$defs/Block"
        }
      },
      "required": [
        "1_essentiel",
        "2_presentation",
        "3_champ",
        "4_gravite",
        "5_conduite",
        "6_examens",
        "7_traitement",
        "8_ne_pas_faire",
        "9_orientation",
        "10_surveillance",
        "11_suivi",
        "12_ordonnance",
        "13_definitions"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "kind",
    "meta",
    "sections"
  ],
  "additionalProperties": false,
  "$defs": {
    "SourceMeta": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "full_guideline",
            "synthesis",
            "update_only",
            "product_info"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "citation": {
          "type": "string",
          "minLength": 1
        },
        "licence": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "page_offset": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "pdf_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "year": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "doi": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "source_id",
        "type",
        "title",
        "citation",
        "licence"
      ],
      "additionalProperties": false
    },
    "Block": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "filled",
            "non_traité",
            "sans_objet"
          ]
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Element"
          }
        }
      },
      "required": [
        "state",
        "elements"
      ],
      "additionalProperties": false
    },
    "Element": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "action",
            "conditional",
            "info",
            "row"
          ]
        },
        "condition": {
          "type": [
            "string",
            "null"
          ]
        },
        "order": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "timing": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "cells": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "translated": {
          "type": "boolean"
        },
        "grade": {
          "type": [
            "string",
            "null"
          ]
        },
        "risk": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "origin": {
          "type": "string",
          "enum": [
            "explicit",
            "local_adaptation"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "conflict_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "variant_group": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checked": {
          "$ref": "#/$defs/Checked"
        },
        "refs": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "attached_to": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "delai": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "immédiat",
                "<1h",
                "<24h"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "phase": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "avant_transfert",
                "pendant_transfert"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "text",
        "type",
        "condition",
        "order",
        "source",
        "translated",
        "grade",
        "risk",
        "origin",
        "conflict_group",
        "missing"
      ],
      "additionalProperties": false
    },
    "SourceRef": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "page_end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_id",
        "page",
        "quote"
      ],
      "additionalProperties": false
    },
    "Checked": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "by",
        "at"
      ],
      "additionalProperties": false
    },
    "Posologie": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "drug_dci": {
          "type": "string",
          "minLength": 1
        },
        "dose": {
          "type": "string"
        },
        "dose_max": {
          "type": [
            "string",
            "null"
          ]
        },
        "route": {
          "type": "string"
        },
        "administration": {
          "type": [
            "string",
            "null"
          ]
        },
        "frequency_or_duration": {
          "type": "string"
        },
        "condition": {
          "type": [
            "string",
            "null"
          ]
        },
        "risk": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "translated": {
          "type": "boolean"
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "titration": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/Titration"
            },
            {
              "type": "null"
            }
          ]
        },
        "algerie": {
          "type": "object",
          "properties": {
            "brands": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Brand"
              }
            },
            "statut": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "Enregistré",
                    "Non renouvelé",
                    "Retiré",
                    "Aucune présentation enregistrée"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "brands",
            "statut"
          ],
          "additionalProperties": false
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "checked": {
          "$ref": "#/$defs/Checked"
        }
      },
      "required": [
        "id",
        "drug_dci",
        "dose",
        "dose_max",
        "route",
        "administration",
        "frequency_or_duration",
        "condition",
        "risk",
        "source",
        "translated",
        "missing",
        "algerie",
        "note"
      ],
      "additionalProperties": false
    },
    "Titration": {
      "type": "object",
      "properties": {
        "start": {
          "type": [
            "string",
            "null"
          ]
        },
        "step": {
          "type": [
            "string",
            "null"
          ]
        },
        "interval": {
          "type": [
            "string",
            "null"
          ]
        },
        "max": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "start",
        "step",
        "interval",
        "max"
      ],
      "additionalProperties": false
    },
    "Brand": {
      "type": "object",
      "properties": {
        "brand": {
          "type": "string"
        },
        "form": {
          "type": "string"
        },
        "dosage": {
          "type": "string"
        },
        "hospital": {
          "type": "boolean"
        }
      },
      "required": [
        "brand",
        "form",
        "dosage",
        "hospital"
      ],
      "additionalProperties": false
    }
  }
}
