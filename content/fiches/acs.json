  "2_presentation": {
   "state": "filled",
   "signes_typiques": [
    {
     "id": "sca-004",
     "text": "Équivalents de douleur thoracique : dyspnée, douleur épigastrique, douleur du bras gauche ou droit, du cou ou de la mâchoire",
     "type": "info",
     "condition": null,
     "order": null,
     "source": {
      "source_id": "esc-2023-sca",
      "page": 16,
      "quote": "Chest pain-equivalent symptoms include dyspnoea, epigastric pain, and pain in the left or right arm or neck/jaw."
     },
     "translated": true,
     "grade": null,
     "risk": "high",
     "origin": "explicit",
     "conflict_group": null,
     "variant_group": null,
     "missing": [],
