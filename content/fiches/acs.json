     "delai": null,
     "checked": {
      "by": "Mounib Zaidi",
      "at": "2026-10-04T12:16:58+00:00"
     }
    }
   ],
   "formes_trompeuses": [
    {
     "id": "sca-006",
     "text": "Ne plus parler de douleur « atypique » : classer la douleur en cardiaque, possiblement cardiaque ou probablement non cardiaque",
     "type": "info",
     "condition": null,
     "order": null,
     "source": {
      "source_id": "esc-2023-sca",
      "page": 16,
      "quote": "Chest pain descriptors should be classified as cardiac, possibly cardiac, and likely non-cardiac."
     },
     "translated": true,
     "grade": null,
     "risk": "medium",
     "origin": "explicit",
     "conflict_group": null,
     "variant_group": null,
     "missing": [],
     "refs": [],
     "attached_to": [],
     "delai": null
    }
   ],
   "examen_clinique": [
    {
     "id": "sca-007",
     "text": "Rechercher tous les pouls, mesurer la PA aux deux bras, ausculter cœur et poumons, rechercher des signes d'IC ou de bas débit",
     "type": "info",
     "condition": null,
     "order": null,
     "source": {
      "source_id": "esc-2023-sca",
      "page": 18,
      "quote": "Focused physical examination should include checking for the presence of all major pulses, measurement of blood pressure in both arms, auscultation of the heart and lungs, and assessing for signs of HF or circulatory compromise."
     },
     "translated": true,
     "grade": null,
     "risk": "medium",
     "origin": "explicit",
     "conflict_group": null,
     "variant_group": null,
     "missing": [],
