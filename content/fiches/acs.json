     }
    },
    {
     "id": "sca-005",
     "text": "Signes d'alerte : douleur thoracique prolongée (> 15 min) ou récidivante dans l'heure",
     "type": "info",
     "condition": null,
     "order": null,
     "source": {
      "source_id": "esc-2023-sca",
      "page": 17,
      "quote": "red flag symptoms such as prolonged chest pain (>15 min) and/or recurrent pain within 1 h"
     },
     "translated": true,
     "grade": null,
     "risk": "high",
     "origin": "explicit",
     "conflict_group": null,
     "variant_group": null,
     "missing": [],
     "refs": [],
