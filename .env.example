# Copy to .env.local (git-ignored). Names only here. Read by services/api and services/crawler.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Database connection, for migrations (supabase/migrations). From WSL use the IPv4 session pooler.
SUPABASE_DB_URL=
# Dashboard origins allowed to call the API, comma-separated (default http://localhost:3000).
CORS_ORIGINS=
# PubMed / PMC searches (NCBI E-utilities).
NCBI_API_KEY=
NCBI_EMAIL=
# Optional "Analyse with AI" in Collecte (OpenRouter): the librarian, then fallbacks, and the classifier.
OPENROUTER_API_KEY=
FACTORY_MODEL=
FACTORY_FALLBACK_MODELS=
CLASSIFIER_MODEL=
